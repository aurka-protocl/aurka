{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VITE_AURKA_MODE=testnet VITE_AURKA_CHAIN_ID=11155111 VITE_AURKA_AGENT_TEST_MODE=false pnpm --filter @aurka/trader-app... build",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "outputDirectory": "apps/trader/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://136.65.161.166/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
