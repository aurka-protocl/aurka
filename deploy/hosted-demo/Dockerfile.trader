FROM node:23.3.0-bookworm-slim AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/trader/package.json apps/trader/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/sdk/package.json packages/sdk/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts=false

COPY apps/trader apps/trader
COPY packages/shared packages/shared
COPY packages/sdk packages/sdk

ARG VITE_AURKA_MODE=fork
ARG VITE_AURKA_CHAIN_ID=31337
ARG VITE_AURKA_API_URL=/api
ENV VITE_AURKA_MODE=${VITE_AURKA_MODE}
ENV VITE_AURKA_CHAIN_ID=${VITE_AURKA_CHAIN_ID}
ENV VITE_AURKA_API_URL=${VITE_AURKA_API_URL}
RUN pnpm --filter @aurka/trader-app... build

FROM caddy:2.8-alpine
COPY deploy/hosted-demo/Caddyfile.trader /etc/caddy/Caddyfile
COPY --from=build /app/apps/trader/dist /srv
