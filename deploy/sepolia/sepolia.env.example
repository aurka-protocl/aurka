# Ethereum Sepolia only. Do not put these values in Vite or commit a filled copy.
AURKA_SEPOLIA_RPC_URL=
# Optional browser-readable/rate-limited RPC. If empty, the local Sepolia app
# gateway proxies receipt polling without exposing the server RPC URL.
AURKA_SEPOLIA_PUBLIC_RPC_URL=
AURKA_SEPOLIA_PRIVATE_KEY=
AURKA_SEPOLIA_DEPLOY=false
AURKA_SEPOLIA_MANIFEST_PATH=deploy/sepolia/sepolia-deployment.json
AURKA_SEPOLIA_SWAPVM_OWNER_ADDRESS=

# mock is the default and must stay labelled as demo pricing in submission materials.
AURKA_SEPOLIA_PRICE_MODE=mock
AURKA_SEPOLIA_CHAINLINK_USDC_USD=
AURKA_SEPOLIA_CHAINLINK_ETH_USD=

# Used by the later hosted/Privy profile; these are public addresses only.
VITE_AURKA_MODE=testnet
VITE_AURKA_CHAIN_ID=11155111
PRIVY_DELEGATED_CHAIN_ID=11155111
AURKA_SETTLEMENT_CHAIN_ID=11155111

# Server-only Privy values. Keep these out of Vite and the public image.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_DELEGATED_WALLET_ID=
PRIVY_DELEGATED_OWNER_ID=
PRIVY_DELEGATED_SIGNER_ID=
PRIVY_DELEGATED_POLICY_ID=
PRIVY_DELEGATED_RECOVERY_POLICY_ID=
PRIVY_DELEGATED_CHAIN_ID=11155111
PRIVY_DELEGATED_ROUTER=
PRIVY_DELEGATED_ROUTER_METHOD=executeWithSwapVM
PRIVY_DELEGATED_INPUT_TOKEN=
PRIVY_DELEGATED_OUTPUT_TOKEN=
PRIVY_DELEGATED_MAX_INPUT_AMOUNT=
PRIVY_DELEGATED_MAX_RECOVERY_AMOUNT=
PRIVY_DELEGATED_POLICY_VALID_UNTIL=
PRIVY_DELEGATED_OWNER_ADDRESS=
PRIVY_DELEGATED_SIGNER_ADDRESS=
PRIVY_DELEGATED_AUTHORIZATION_PRIVATE_KEY=
PRIVY_DELEGATED_OWNER_AUTHORIZATION_PRIVATE_KEY=
PRIVY_DELEGATED_BROADCAST_MODE=sign-and-broadcast
PRIVY_DELEGATED_PROVISION=false

# Per-user agent session/faucet controls. These are server-side only; users
# never need to add a Privy or faucet value to their browser environment.
AURKA_ALLOWED_ORIGINS=http://127.0.0.1:3002
AURKA_SESSION_SECONDS=28800
AURKA_AGENT_WORKER_INTERVAL_MS=15000
AURKA_AGENT_FAUCET_COOLDOWN_SECONDS=60
AURKA_AGENT_FAUCET_MAX_ETH_WEI=10000000000000000
AURKA_AGENT_FAUCET_MAX_USDC=1000000000
AURKA_AGENT_FAUCET_MAX_WETH_WEI=1000000000000000000
AURKA_AGENT_FAUCET_GLOBAL_MAX_ETH_WEI=1000000000000000000
AURKA_AGENT_FAUCET_GLOBAL_MAX_USDC=100000000000
AURKA_AGENT_FAUCET_GLOBAL_MAX_WETH_WEI=100000000000000000000
