  },
  "dependencies": {
    "@aurka/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "@aurka/services": "workspace:*"
  }
}
