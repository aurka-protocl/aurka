{
  "name": "@aurka/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "AURKA SDK for discovery, quotes, proposals, risk, and execution",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
