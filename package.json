  "description": "Agentic portfolio-constrained liquidity protocol",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
