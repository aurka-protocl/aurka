MAINNET_RPC_URL=

# Privy
# Server-only backend credentials. The browser must never receive these values.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Dedicated delegated-agent custody is opt-in. The owner and signer IDs are
# Privy key-quorum IDs; Bob's browser address is never used as a Privy owner.
PRIVY_DELEGATED_WALLET_ID=
PRIVY_DELEGATED_OWNER_ID=
PRIVY_DELEGATED_SIGNER_ID=
PRIVY_DELEGATED_POLICY_ID=
# The wallet base policy is owner-recovery-only; the delegated policy is an
# additional-signer override. Privy currently supports one base policy/wallet.
PRIVY_DELEGATED_RECOVERY_POLICY_ID=
PRIVY_DELEGATED_CHAIN_ID=31337
PRIVY_DELEGATED_ROUTER=
PRIVY_DELEGATED_INPUT_TOKEN=
PRIVY_DELEGATED_OUTPUT_TOKEN=
PRIVY_DELEGATED_MAX_INPUT_AMOUNT=
PRIVY_DELEGATED_MAX_RECOVERY_AMOUNT=
PRIVY_DELEGATED_POLICY_VALID_UNTIL=
PRIVY_DELEGATED_OWNER_ADDRESS=
PRIVY_DELEGATED_SIGNER_ADDRESS=
# Server-only Privy P-256 authorization keys. Never put these in the browser.
PRIVY_DELEGATED_AUTHORIZATION_PRIVATE_KEY=
PRIVY_DELEGATED_OWNER_AUTHORIZATION_PRIVATE_KEY=
PRIVY_DELEGATED_BROADCAST_MODE=sign-and-broadcast
PRIVY_DELEGATED_PROVISION=false
# Optional overrides for the bundled server-only policy/operator modules. The
# defaults are packages/wallet/scripts/privy-delegated-operator.mjs and
# privy-delegated-authorization.mjs.
PRIVY_DELEGATED_POLICY_MODULE=
PRIVY_DELEGATED_AUTHORIZATION_MODULE=

# The Graph
GRAPH_API_KEY=
GRAPH_GATEWAY_URL=https://gateway.thegraph.com

# Optional AI-generated explanations. AI never determines enforceable values.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Bounded server-only agent controls. The browser never receives this key.
OPENROUTER_TIMEOUT_MS=15000
OPENROUTER_MAX_TOOL_CALLS=4
OPENROUTER_MAX_CONCURRENT_PROPOSALS=2
# The fork gateway allows the provider deadline plus proxy overhead.
AURKA_FORK_REQUEST_TIMEOUT_MS=30000

# Service readiness budgets (the defaults are bounded and conservative).
READINESS_PROBE_TIMEOUT_MS=2000
READINESS_CACHE_TTL_SECONDS=5
INDEXER_MAX_LAG_BLOCKS=20
RPC_FINALITY_MAX_AGE_SECONDS=120

# Browser app links. Leave blank for local ports 3001 (treasury) and 3002
# (trader); hosted deployments should set the public URLs explicitly.
VITE_AURKA_TREASURY_URL=
VITE_AURKA_TRADER_URL=

# Optional deployment wallet. Never use production funds in this MVP.
DEPLOYER_PRIVATE_KEY=
